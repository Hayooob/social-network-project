# --- Go ---
# Compiled binaries
/backend/server
/backend/cmd/main
*.exe
*.test
*.out

# Local Go workspace overrides (never committed)
go.work
go.work.sum

# --- Database ---
# SQLite lives at runtime only; it is recreated from internal/db/migrations
*.db
*.db-journal
*.db-wal
*.db-shm

# --- User uploads ---
# Avatars and post images are user data, not source
/backend/uploads/*
!/backend/uploads/.gitkeep

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.local

# --- Environment ---
.env
.env.*
!.env.example

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
